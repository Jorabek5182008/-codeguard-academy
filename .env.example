# Copy to .env.local and fill in. Never commit .env.local.

# --- Admin dashboard ---
ADMIN_USERNAME=admin
# Generate with: node scripts/hash-password.js "your-strong-password"
ADMIN_PASSWORD_HASH=

# Random long string signing admin session tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# --- Branding ---
SITE_NAME=CodeGuard
INSTAGRAM_PROFILE_URL=https://instagram.com/code_guard_
PORTAL_PUBLIC_URL=https://codeguard.uz

# --- Payment (placeholder) ---
# CodeGuard does not process real payments yet. When you have a real
# merchant account with Click, Payme, or Uzcard, wire their API into
# lib/payments.js and set these. Until then, the "To'lov" section only
# collects plan interest and shows manual payment instructions.
PAYMENT_MODE=manual
CLICK_MERCHANT_ID=
PAYME_MERCHANT_ID=
